# ─────────────────────────────────────────────
# SUPABASE
# https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://abc123.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────────────────────────
# SITE URL  (sin trailing slash)
# En Vercel se rellena automáticamente con la URL del deploy
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────
# LEMON SQUEEZY
# https://app.lemonsqueezy.com/settings/api
# ─────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=your_api_key_here
LEMON_SQUEEZY_STORE_ID=your_store_id_here
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
# ID de la variante del plan Pro (Products → tu producto → Variants → ID)
LEMON_SQUEEZY_VARIANT_ID=your_variant_id_here

# ─────────────────────────────────────────────
# RESEND
# https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
